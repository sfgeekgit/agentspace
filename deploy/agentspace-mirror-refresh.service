# The public mirror's refresh trigger, loopback only (Caddy proxies POST /publicview/refresh to it).
# Install: sudo cp deploy/agentspace-mirror-refresh.service /etc/systemd/system/ && sudo systemctl enable --now agentspace-mirror-refresh
[Unit]
Description=agentspace public mirror refresh trigger (loopback only)
After=docker.service

[Service]
User=cc
WorkingDirectory=/opt/agentspace-ctl
ExecStart=/usr/bin/python3 -u /opt/agentspace-ctl/mirror_refresh.py
Restart=always
RestartSec=2
# Covers the publisher it spawns: four runs' logs are held in memory at a time, capped at 25 MB each.
MemoryMax=300M
TasksMax=50

[Install]
WantedBy=multi-user.target
