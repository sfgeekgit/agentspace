#!/usr/bin/env python3
"""Agent-facing: print this world's OpenRouter spend + limit."""
import json, urllib.request
try:
    key = open("/run/svc/openrouter_key").read().strip()
except FileNotFoundError:
    raise SystemExit("key not injected — control plane must re-inject on container start")
req = urllib.request.Request("https://openrouter.ai/api/v1/auth/key",
                             headers={"Authorization": "Bearer " + key})
d = json.load(urllib.request.urlopen(req, timeout=15))["data"]
print(json.dumps({"usage_usd": d.get("usage"), "limit_usd": d.get("limit")}))
